{
	"appId": "com.tovoapp.productivity",
	"appName": "Tovo",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DEFAULT"
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"google.com"
			]
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_tovo",
			"iconColor": "#303FCA"
		}
	}
}
